# Normalize all text files to LF in the repository and the working tree (the index is already LF;
# core.autocrlf=true otherwise yields CRLF checkouts and a wall of "LF will be replaced by CRLF" warnings).
* text=auto eol=lf

# Bash scripts must stay LF even on Windows checkouts (core.autocrlf=true would turn them
# CRLF in the working tree, and a locally built plugin ZIP would ship a broken script —
# bash fails on CRLF both on macOS/Linux and in WSL mode).
*.sh    text eol=lf
gradlew text eol=lf

# Windows scripts keep CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
